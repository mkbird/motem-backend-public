# Robot Backend 配置
# 变量名前缀为 ROBOT_（由 pydantic-settings 自动匹配）

# ── App ──
# 部署区域：cn=中国大陆，overseas=海外
ROBOT_REGION=cn
ROBOT_LISTEN_HOST=127.0.0.1
# Opt in only after restricting the separately installed gRPC services to a
# trusted network. They are not automatically secured by HTTP authentication.
ROBOT_START_GRPC=0

# ── 数据库 ──
ROBOT_MYSQL_HOST=localhost
ROBOT_MYSQL_PORT=3306
ROBOT_MYSQL_USER=root
ROBOT_MYSQL_PASSWORD=
ROBOT_MYSQL_DATABASE=robot

# ── Redis ──
ROBOT_REDIS_URL=redis://localhost:6379/0

# ── JWT ──
ROBOT_JWT_SECRET_KEY=
# Generate your own value before starting the server:
# python -c 'import secrets; print(secrets.token_hex(32))'

# ── DashScope（LLM、ASR/TTS、天气、搜索统一使用） ──
ROBOT_DASHSCOPE_API_KEY=
ROBOT_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ROBOT_DEFAULT_MODEL=qwen-plus

# ── 高德地图（逆地理编码，国内备用） ──
ROBOT_AMAP_API_KEY=

# ── gRPC 语音服务 ──
ROBOT_GRPC_ASR_ADDR=localhost:8011
ROBOT_GRPC_TTS_ADDR=localhost:8012

# ── Anthropic（Claude Code SDK, 游戏 / widget 代码生成） ──
#
# 三种 token 模式（三选一，三个字段配合使用）：
#
# 1) Claude Pro / Max 订阅 OAuth（最便宜 — 走个人订阅配额，不另付费）：
#    本机跑 `claude setup-token` 拿 sk-ant-oat01-* token，BASE_URL 留空。
#       ROBOT_ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-XXXX
#       ROBOT_ANTHROPIC_API_KEY=""
#       ROBOT_ANTHROPIC_BASE_URL=""
#    注意：oat01 token 1 年有效期，过期重跑 `claude setup-token` 即可。
#
# 2) Anthropic Console PAYG API key（按 token 计费，无限流）：
#       ROBOT_ANTHROPIC_API_KEY=sk-ant-XXXX
#       ROBOT_ANTHROPIC_AUTH_TOKEN=""
#       ROBOT_ANTHROPIC_BASE_URL=""
#
# 3) 第三方 router（OpenRouter / 自建反代 — 当前默认模式）：
#       ROBOT_ANTHROPIC_AUTH_TOKEN=sk-or-v1-XXXX
#       ROBOT_ANTHROPIC_API_KEY=""
#       ROBOT_ANTHROPIC_BASE_URL=https://openrouter.ai/api
#
# 代码自动按 AUTH_TOKEN 前缀分发到正确的 env var：
#   sk-ant-oat01-* → CLAUDE_CODE_OAUTH_TOKEN（订阅协议）
#   sk-or-* / 其他 → ANTHROPIC_AUTH_TOKEN（router bearer）
#   sk-ant-*       → ANTHROPIC_API_KEY（official PAYG）
# 详见 robot/agent/tools/game_tools.py::_run_claude_agent。
ROBOT_ANTHROPIC_AUTH_TOKEN=
ROBOT_ANTHROPIC_API_KEY=
ROBOT_ANTHROPIC_BASE_URL=

# ── Godot（godot-mcp 场景操作和项目验证） ──
# 留空则让 godot-mcp 自动检测；如需指定可填可执行文件绝对路径
ROBOT_GODOT_PATH=

# ── Claude Code SDK 模型（游戏代码生成 - create_game 路径用） ──
# 经 OpenRouter 时走 sk-or-v1-* token + base_url=https://openrouter.ai/api。
# 默认 z-ai/glm-5.1（开源 SOTA SWE-bench 77.8%，长任务自主）。
# 也可填 z-ai/glm-5 / z-ai/glm-4.7 / anthropic/claude-4.6-sonnet-* 等。

# ── Claude Code SDK 模型（游戏修改 - modify_game 路径专用） ──
# 与 create 分开：modify 是增量改动 + sliding-window compact 后 input 已控制
# 在 ~30K tokens，便宜小快的 haiku 4.5 足够；复杂 modify 也能扛。
# 默认 haiku 4.5（$1/$5、200K context）。
ROBOT_GAME_CODE_MODEL=anthropic/claude-sonnet-4.6
ROBOT_GAME_MODIFY_MODEL=anthropic/claude-haiku-4.5

# ── Claude Code SDK 模型（小组件生成） ──
# 与 game 拆开：widget 是单文件 HTML+JS 小活，便宜代码模型 ROI 高。
# 留空 → 让 SDK 用默认值。推荐：
#   qwen/qwen3-coder-next  ($0.14/$0.80) — 2026-02 sparse MoE 专精 agentic（首选）
#   z-ai/glm-4.7-flash     ($0.06/$0.40) — 2026-01 超低价
#   qwen/qwen3-coder-plus  ($0.65/$3.25) — Alibaba proprietary 强版
ROBOT_WIDGET_CODE_MODEL=qwen/qwen3-coder-next

# ── Claude Code CLI 输出上限 ──
# 单次 SDK 调用最大 output tokens。默认 8000，游戏 / widget 生成需要更高。
CLAUDE_CODE_MAX_OUTPUT_TOKENS=32000

# ── 调试开关（仅诊断时启用，生产环境留空）──
#
# 让 Claude Code SDK 子进程加 --debug api --debug-file 参数，把 CLI api 调试
# 日志（含 skill load / tool dispatch / token estimate）落盘。配合
# scripts/openrouter_proxy.py 反代可以同时抓真实 request body + 真实 cost：
#
#   1. 启 proxy：
#        python scripts/openrouter_proxy.py &
#   2. 改 ROBOT_ANTHROPIC_BASE_URL=http://127.0.0.1:8080/api
#   3. 设此 env var 指定 dump 目录
#   4. 重启 backend
#   5. 触发一次 create/modify，盘上落两份文件：
#        req_<ts>.json   完整 request body（system/tools/messages）
#        resp_<ts>.json  响应 + 真实 OpenRouter usage.cost
#
# 注意：env var 不通过 pydantic Settings 读取（不在 Settings fields 里），
# 靠 os.environ.get 直读 → 必须在启动 uvicorn 前 export，或写到 .env 里
# 重启完整 backend（uvicorn --reload 不读 .env 改动）。
ROBOT_CODE_AGENT_DEBUG_DUMP_DIR=

ROBOT_APNS_KEY_PATH=
ROBOT_APNS_KEY_ID=
ROBOT_APNS_TEAM_ID=
ROBOT_APNS_BUNDLE_ID=

# ── Web (HTML5) 导出 + 公开 /play 链接（②③⑥） ──
# 开启后游戏 create/modify 收尾会异步导出网页版、发布到 web_builds/，
# 对外经 /play/{game_id}/ serve。需服务器装 Godot 4.6 + Web 导出模板。
ROBOT_WEB_EXPORT_ENABLED=0
# 对外公开 base URL（/play 与 /share 链接前缀）。留空则按请求 Host 推断；
# 但 bot 无 request 上下文 → 用 bot 时必须显式填（如 ngrok / 正式域名）。
ROBOT_SHARE_PUBLIC_BASE_URL=

# ── Bot 适配层（① 文本创作/修改游戏 → 回 /play 链接） ──
# 需装 discord.py；token 绝不进 git（.env 已被 .gitignore 忽略）。
# 获取步骤见 docs/discord-game-bot-v1-plan.md、robot/bot/README.md。
ROBOT_DISCORD_BOT_ENABLED=0
ROBOT_DISCORD_BOT_TOKEN=
# 仅监听这个频道 id（留空 = 任意频道；联调时建议填测试频道）
ROBOT_DISCORD_BOT_CHANNEL_ID=
# bot 以哪个后端 users.id 身份创作游戏（联调前先建用户、把 id 填这里）
ROBOT_BOT_OWNER_USER_ID=
# ── 创作门禁（⑤）──
# 全局 kill-switch：=0 立即停掉一切创作/修改（成本失控急停）。
ROBOT_BOT_CREATION_ENABLED=1
# 每个发起者每日配额（24h 窗口）。
ROBOT_BOT_DAILY_CREATE_LIMIT=20
ROBOT_BOT_DAILY_MODIFY_LIMIT=50
